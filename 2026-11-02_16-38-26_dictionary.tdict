  "ཐམས་ཅད་མཁྱེན་པ": [
    "<div style=\"box-sizing: border-box; color: rgba(0, 0, 0, 0.87); font-family: Roboto, -apple-system, BlinkMacSystemFont, &quot;Noto serif tibetan&quot;, sans-serif; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-top: 5px; padding: 10px; background: rgb(249, 249, 249); border-radius: 4px; border-left: 3px solid var(--primary);\"><b style=\"box-sizing: border-box; color: rgb(0, 85, 170);\">[Rangjung Yeshe]:</b><span>&nbsp;</span>omniscience [thd]. all knowing, [omniscient]; Level of omniscience, Omniscience, total enlightenment, buddhahood, all-knowledge, all knowing, [omniscient]. title for high lamas and an epithet of the Buddha. Level of omniscience. Same as complete buddhahood. Omniscient ones. Same as 'buddhas.'</div><br class=\"Apple-interchange-newline\"><br>"
  ],
  "སར": [
    "<div class=\"dsl_article\" style=\"display: inline; \"><div class=\"dsl_headwords\" style=\"font-weight: bold; margin-top: 15px; margin-bottom: 10px; \"><p style=\"font-weight: bold; font-size: 15px; margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; \">སར</p></div><div class=\"dsl_definition\"><div class=\"dsl_m1\" style=\"padding-left: 9px; \">in the place, on the ground [JV]</div></div></div><div class=\"dsl_article\" style=\"display: inline; \"><div class=\"dsl_headwords\" style=\"font-weight: bold; margin-top: 15px; margin-bottom: 10px; \"><p style=\"font-weight: bold; font-size: 15px; margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; \">སར</p></div><div class=\"dsl_definition\"><div class=\"dsl_m1\" style=\"padding-left: 9px; \">{དབྱུག་གུ་ ཅན་ གྱི་ སར་ ཕྱིན་ པ་} went to dandana's house [RY]</div></div></div><div class=\"dsl_article\" style=\"display: inline; \"><div class=\"dsl_headwords\" style=\"font-weight: bold; margin-top: 15px; margin-bottom: 10px; \"><p style=\"font-weight: bold; font-size: 15px; margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; \">སར</p></div><div class=\"dsl_definition\"><div class=\"dsl_m1\" style=\"padding-left: 9px; \">on the ground, place/ presence of [IW]</div></div></div>"
