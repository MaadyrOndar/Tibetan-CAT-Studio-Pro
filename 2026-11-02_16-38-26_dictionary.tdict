  "ཕྱག་འཚལ་ཞིང": [
    "Тейлевишаан",
    "<strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"c\" data-complete=\"true\" style=\"font-family: Google Sans, Arial, sans-serif, Noto Color Emoji; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"c\" data-complete=\"true\" style=\"font-family: Google Sans, Arial, sans-serif, Noto Color Emoji; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span data-subtree=\"aimfl,mfl\" style=\"font-family: Google Sans, Arial, sans-serif, Noto Color Emoji; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Тиртхика</span></span></strong> (санскр. tīrthika, пали titthiya — «создатель брода», «тот, кто ищет брод») — это <mark class=\"b6AQX\" data-wiz-attrbind=\"class=EUFafd_s/cFwyDc\" data-sfc-root=\"c\" data-ved=\"2ahUKEwinzJGR0OiXAxUAxgIHHaqdJ_IQuJAPegoIAggACAAICRAB\" data-complete=\"true\" style=\"font-family: Google Sans, Arial, sans-serif, Noto Color Emoji; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">термин в индийских религиях (буддизме и джайнизме), обозначающий сторонников небуддийских (или неджайнистских) учений, философий и аскетов</mark>",
    "<b style=\"box-sizing: border-box; font-family: Roboto, -apple-system, BlinkMacSystemFont, &quot;Noto serif tibetan&quot;, sans-serif; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(0, 85, 170);\">[Rangjung Yeshe]:</b><span style=\"color: rgba(0, 0, 0, 0.87); font-family: Roboto, -apple-system, BlinkMacSystemFont, &quot;Noto serif tibetan&quot;, sans-serif; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\"><span>&nbsp;</span>{mu stegs rnams la phyag 'tshal zhing} bowed down to the tirthikas</span>",
    "<pre class=\"tw-data-text tw-text-large tw-ta\" data-placeholder=\"Перевод\" id=\"tw-target-text\" role=\"text\" style=\"text-align:left\" tabindex=\"-1\" data-ved=\"2ahUKEwidtqi6veiXAxUO0wIHHfRbF64Q3ewLegQIGRAU\" dir=\"ltr\" aria-label=\"Переведенный текст: поклонился тиртхикам\"><span class=\"Y2IQFc\" lang=\"ru\">Поклонился тиртхикам</span></pre>"
  ],
