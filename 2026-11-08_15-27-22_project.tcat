{
  "segments": [
    {
      "source": "༄༅། །ལམ་རིམ་གསེར་ཞུན་མ། །",
      "target": "<div><span class=\"hl\">Этапы пути: Сущность чистого золота</span></div><div>Ламрим Сершунма</div>",
      "confirmed": true,
      "note": "",
      "bookmarked": false
    },
    {
      "source": "༄༅། །བྱང་ཆུབ་ལམ་གྱི་རིམ་པའི་ཁྲིད་གསེར་གྱི་ཡང་ཞུན་ཞེས་བྱ་བ་བཞུགས་སོ། །",
      "target": "<p class=\"MsoNormal\"><span class=\"hl\">Здесь содержится руководство по этапам пути к просветлению, озаглавленное «Сущность очищенного золота».</span></p><p class=\"MsoNormal\">Долу отуушкун чедип алырының чадалары,<br>Арыг алдын дег сүүзүннүг удуртулга.</p>",
      "confirmed": true,
      "note": "",
      "bookmarked": false
    },
    {
      "source": "༄༅། །རྗེ་བཙུན་བླ་མ་སྐྱབས་གསུམ་ཀུན་འདུས་ཀྱི་བདག་ཉིད་ཆེན་པོ་གང་དེའི་ཞབས་ལ་གུས་པ་ཆེན་པོས་ཕྱག་འཚལ་ཞིང་སྐྱབས་སུ་མཆིའོ།",
