riority=\"49\" Name=\"List Table 4 Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"46\"\n   Name=\"List Table 1 Light Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"47\" Name=\"List Table 2 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"48\" Name=\"List Table 3 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"49\" Name=\"List Table 4 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"46\"\n   Name=\"List Table 1 Light Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"47\" Name=\"List Table 2 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"48\" Name=\"List Table 3 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"49\" Name=\"List Table 4 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 6\"/>\n </w:LatentStyles>\n</xml><![endif]--><!--[if gte mso 10]>\n<style>\n /* Style Definitions */\n table.MsoNormalTable\n\t{mso-style-name:\"Обычная таблица\";\n\tmso-tstyle-rowband-size:0;\n\tmso-tstyle-colband-size:0;\n\tmso-style-noshow:yes;\n\tmso-style-priority:99;\n\tmso-style-parent:\"\";\n\tmso-padding-alt:0cm 5.4pt 0cm 5.4pt;\n\tmso-para-margin:0cm;\n\tmso-para-margin-bottom:.0001pt;\n\tmso-pagination:widow-orphan;\n\tfont-size:10.0pt;\n\tfont-family:\"Times New Roman\",serif;\n\tmso-bidi-language:BO;}\n</style>\n<![endif]-->\n\n<p class=\"MsoNormal\"><span style=\"background-color: rgb(187, 247, 208);\"><span class=\"hl\">Венец всех ученых этого мира<br><br>Анализ и введение<br>Строка «dzam gling mkhas pa yongs kyi gtsug gi rgyan» (འཛམ་གླིང་མཁས་པ་ཡོངས་ཀྱི་གཙུག་གི་རྒྱན།) — одна из самых известных вступительных формул в тибетской ученой традиции и литературе жанра «ламрим» (этапы пути к просветлению). Это эпитет, прославляющий основополагающих индийских учителей — в частности, великих первопроходцев Нагарджуну (ཀླུ་སྒྲུབ་) и Асангу (ཐོགས་མེད་), которые утвердили, соответственно, линии передачи «глубокого воззрения» (zab mo lta ba) и «обширных деяний» (rgya che spyod pa) в рамках пути Махаяны.<br><br>В литургической и философской традиции, заложенной Дже Цонкапой Лобсангом Дракпой, эта фраза неизменно встречается в восхвалениях, открывающих его ключевые труды, посвященные этапам пути, — такие как «Ламрим дудон» (Lam rim bsdus don) и «Ламрим ченмо» (Lam rim chen mo). В структуре текста эта строка непосредственно связана с последующими стихами: «Венец всех ученых этого мира, чьи знамена славы ярко реют среди живых существ; линия, берущая начало от Нагарджуны и Асанги и передававшаяся далее, — это превосходная традиция этапов пути к просветлению». Впоследствии многие комментаторы, принадлежащие к различным школам — например, Первый Панчен-лама Лобсанг Чокьи Гьялцен и Пабонгка Дечен Ньингпо, — часто цитируют и подробно разъясняют этот фрагмент, чтобы подтвердить чистоту и авторитетность линии передачи ламрима, восходящей непосредственно к этим величайшим мыслителям Джамбудвипы.</span></span></p><p class=\"MsoNormal\"><span style=\"background-color: rgb(187, 247, 208);\"><br></span></p><p class=\"MsoNormal\"><span style=\"background-color: rgb(187, 247, 208);\">Чамбыдиптиң мерген-угааныг Нагарджуна-биле Асангхадан\nчергелештир келген, каас-чараш ёзу-чаңчылдары — Долу отуушкун чедип алыр\nчадалар. Амылыгларның кырында сүлде-тук ышкаш киискип чору.</span></p>\n\n<p class=\"MsoNormal\"><span style=\"background-color: rgb(187, 247, 208);\">Амылыгларның күзелдерин шуптулазын долдуруптар\nыдык-күчүлүг<span style=\"mso-spacerun:yes\">  </span>Джово Атиша башкының\nтергиин кылдыр соглээн өөредии, муң-муң хемнер дег, судурларын чыыыптарга далай\nышкаш болуп кээр.</span></p>\n\n<p class=\"MsoNormal\"><span style=\"background-color: rgb(187, 247, 208);\">Йорээлин салган</span></p><p class=\"MsoNormal\"><span style=\"background-color: rgb(254, 202, 202);\">30 дугаар одуругга чедир очулгазы<span lang=\"BO\" style=\"font-size:10.0pt;\nmso-ansi-font-size:10.5pt\"></span></span></p>",
      "confirmed": false,
      "note": "",
      "bookmarked": false
    },
